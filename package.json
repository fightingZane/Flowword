{
  "name": "flowword",
  "description": "低干扰的 YouTube 英语字幕悬浮助手",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "test:features": "node scripts/features-e2e.mjs",
    "test:upgrade": "node scripts/upgrade-e2e.mjs",
    "test:archive": "node tests/archive-browser.mjs",
    "test:sites": "node scripts/sites-e2e.mjs",
    "test:translation": "node scripts/translation-live.mjs",
    "test:youtube": "node scripts/youtube-smoke.mjs",
    "browser:install": "node scripts/install-browser.mjs",
    "package": "node scripts/package.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:e2e && npm run test:features && npm run test:upgrade && npm run test:archive && npm run test:sites && npm run test:layout && npm run test:panels && npm run test:dom-replay",
    "postinstall": "wxt prepare",
    "test:layout": "node tests/archive-layout-browser.mjs",
    "test:panels": "node scripts/panels-e2e.mjs",
    "test:dom-replay": "node scripts/dom-replay-e2e.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "wxt": "0.21.4"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
